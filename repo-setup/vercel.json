{
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "30 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/jai-demo.html"
    },
    {
      "source": "/ai",
      "destination": "/ai-playground.html"
    },
    {
      "source": "/piece/:id",
      "destination": "/api/piece-page?id=:id"
    },
    {
      "source": "/tracker",
      "destination": "/index.html"
    },
    {
      "source": "/tracker/phase2",
      "destination": "/index.html"
    }
  ]
}
